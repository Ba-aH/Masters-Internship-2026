        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an expert academic reference extractor and cleaner. Always respond with valid JSON only.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Extract and clean the following messy reference list into a JSON array of references.\\n\\nEach reference must have these fields:\\n- title (string, required)\\n- authors (array of strings)\\n- year (number or null)\\n- journal (string or null)\\n\\nRules:\\n- Split merged references into separate entries\\n- Clean and correct obvious errors in titles and author names\\n- Return ONLY a valid JSON array like: [ { \\\"title\\\": \\\"...\\\", \\\"authors\\\": [...], ... }, ... ]\\n- Do not add any extra text, explanations, or markdown.\\n\\nHere is the messy reference list:\\n\\n{{ $('GET references').item.json.content }}\"\n    }\n  ],\n  \"temperature\": 0.1,\n  \"max_tokens\": 2500,\n  \"response_format\": { \"type\": \"json_object\" }\n}",
        "options": {}
      },
