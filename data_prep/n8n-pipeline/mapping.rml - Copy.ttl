# ====================== AUTHORS ======================
# Author nodes — built from author_links so every author
# (main paper or reference) is created from one source.

map:AuthorMap
    a rr:TriplesMap ;
    rml:logicalSource map:AuthorLinksSource ;

    rr:subjectMap [
        rr:template "https://citekg.org/resource/author/{author_id}" ;
        rr:class citekg:Author
    ] ;

    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ rml:reference "author_name" ; rr:language "en" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "author_name" ; rr:language "en" ]
    ] .

# ====================== PAPER → AUTHOR (hasAuthor) ======================

map:PaperAuthorLink
    a rr:TriplesMap ;
    rml:logicalSource map:AuthorLinksSource ;

    rr:subjectMap [
        rr:template "https://citekg.org/resource/paper/{paper_id}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:hasAuthor ;
        rr:objectMap [
            rr:template "https://citekg.org/resource/author/{author_id}" ;
            rr:termType rr:IRI
        ]
    ] .

# ====================== AUTHOR → PAPER (authorOf — inverse) ======================

map:AuthorPaperLink
    a rr:TriplesMap ;
    rml:logicalSource map:AuthorLinksSource ;

    rr:subjectMap [
        rr:template "https://citekg.org/resource/author/{author_id}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:authorOf ;
        rr:objectMap [
            rr:template "https://citekg.org/resource/paper/{paper_id}" ;
            rr:termType rr:IRI
        ]
    ] .
