@prefix rr:       <http://www.w3.org/ns/r2rml#> .
@prefix rml:      <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:       <http://semweb.mmlab.be/ns/ql#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix citekg:   <https://citekg.org/ontology#> .
@prefix map:      <http://citekg.org/mapping#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# ====================== LOGICAL SOURCES ======================

map:PaperSource
    rml:source "references.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$" .

map:RefsSource
    rml:source "references.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$.references[*]" .

map:AuthorLinksSource
    rml:source "references.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$.author_links[*]" .

# ====================== MAIN PAPER ======================

map:MainPaperMap
    a rr:TriplesMap ;
    rml:logicalSource map:PaperSource ;

    rr:subjectMap [
        rr:template "https://citekg.org/resource/paper/{paper.paper_id}" ;
        rr:class citekg:Paper
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:title ;
        rr:objectMap [ rml:reference "paper.title" ; rr:language "en" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:year ;
        rr:objectMap [ rml:reference "paper.year" ; rr:datatype xsd:gYear ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:doi ;
        rr:objectMap [ rml:reference "paper.doi" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:openAlexFound ;
        rr:objectMap [ rml:reference "paper.openalex_found" ; rr:datatype xsd:boolean ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:totalReferences ;
        rr:objectMap [ rml:reference "total" ; rr:datatype xsd:integer ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:verifiedCount ;
        rr:objectMap [ rml:reference "verified" ; rr:datatype xsd:integer ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:citationCount ;
        rr:objectMap [ rml:reference "paper.citation_count" ; rr:datatype xsd:integer ]
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "paper.title" ; rr:language "en" ]
    ] .
# ====================== REFERENCE PAPERS ======================

map:RefPaperMap
    a rr:TriplesMap ;
    rml:logicalSource map:RefsSource ;

    rr:subjectMap [
        rr:template "https://citekg.org/resource/paper/{paper_id}" ;
        rr:class citekg:Paper
    ] ;

    rr:predicateObjectMap [
        rr:predicate dcterms:title ;
        rr:objectMap [ rml:reference "title" ; rr:language "en" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:year ;
        rr:objectMap [ rml:reference "year" ; rr:datatype xsd:gYear ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:doi ;
        rr:objectMap [ rml:reference "doi" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:openAlexFound ;
        rr:objectMap [ rml:reference "openalex_found" ; rr:datatype xsd:boolean ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:openAlexScore ;
        rr:objectMap [ rml:reference "openalex_score" ; rr:datatype xsd:decimal ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:citationCount ;
        rr:objectMap [ rml:reference "citation_count" ; rr:datatype xsd:integer ]
    ] ;
   
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "title" ; rr:language "en" ]
    ] .

# ====================== DIRECT CITATION RELATIONS ======================
# citekg:cites    — main paper → referenced paper  (forward direction)
# citekg:isCitedBy — referenced paper → main paper (inverse direction)
#
# Both maps iterate over $.references[*].
# Each reference now carries main_paper_id (stamped by Python) so the
# template can resolve it without navigating up to the parent object.

map:MainCitesRef
    a rr:TriplesMap ;
    rml:logicalSource map:RefsSource ;

    rr:subjectMap [
        rr:template "https://citekg.org/resource/paper/{main_paper_id}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:cites ;
        rr:objectMap [
            rr:template "https://citekg.org/resource/paper/{paper_id}" ;
            rr:termType rr:IRI
        ]
    ] .

map:RefIsCitedBy
    a rr:TriplesMap ;
    rml:logicalSource map:RefsSource ;

    rr:subjectMap [
        rr:template "https://citekg.org/resource/paper/{paper_id}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate citekg:isCitedBy ;
        rr:objectMap [
            rr:template "https://citekg.org/resource/paper/{main_paper_id}" ;
            rr:termType rr:IRI
        ]
    ] .

